TWITCH_MODE=mock
PORT=4174
MOCK_VIEWERS=60
MOCK_DELAY_MS=2500-4500
DASHBOARD_LAN=0
# Simplest connection: npm run twitch, then enter a PUBLIC app's Client ID on the dashboard.
# No .env edits, client secret or manually generated access tokens are required for that flow.
# These fields are optional for development or an existing Confidential app.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_AUTH_FLOW=auto
TWITCH_REDIRECT_URI=http://localhost:4174/auth/callback
